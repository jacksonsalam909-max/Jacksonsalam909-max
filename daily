<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, query, where, deleteDoc, doc, serverTimestamp, updateDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
const config={apiKey:"AIzaSyB8Eu2ScZyR62gfkGXKs1sMp3ZudLtGdFE",authDomain:"discharge-b9528.firebaseapp.com",projectId:"discharge-b9528",storageBucket:"discharge-b9528.firebasestorage.app",messagingSenderId:"1076050472607",appId:"1:1076050472607:web:736e0688a41462460efcaa"};
const app=initializeApp(config,"dailyMain_"+Math.random());const db=getFirestore(app);
window.db=db;window.fb={collection,addDoc,getDocs,query,where,deleteDoc,doc,serverTimestamp,updateDoc};
document.getElementById('fbStatus').innerText="Firebase Connected - PMJAY from TOTAL";
window.__fbMaster = []; window.masterMapByShri = {};
async function loadMasterPatients(){
  try{
    const snap = await getDocs(collection(db,"patients"));
    let fbPatients=[]; 
    snap.forEach(d=>{ 
      let p=d.data(); if(p.deleted) return; 
      let shri = (p.shriId||p.shri||'').toString().toUpperCase().trim();
      let pmjay = (p.pmjayId||p.PMJAY||p.pmjay||'').toString().trim();
      let name = (p.patientName||p.name||'').toString().trim();
      fbPatients.push({ patientName: name, shriId: shri, pmjayId: pmjay });
      if(shri) window.masterMapByShri[shri] = { pmjayId: pmjay, name: name };
    });
    window.__fbMaster=fbPatients;
    document.getElementById('totalLoaded').textContent=fbPatients.length;
  }catch(e){}
}
loadMasterPatients();
</script>
<script>
function toggleMenu(){ var s=document.getElementById('side'); var o=document.getElementById('overlay'); s.classList.toggle('show'); o.classList.toggle('show'); }
document.addEventListener('DOMContentLoaded',function(){ var b=document.getElementById('menuBtn'); var o=document.getElementById('overlay'); b.addEventListener('click', toggleMenu); o.addEventListener('click', toggleMenu); });
function onSchemeChange(val){ var d=document.getElementById('d_date').value||''; if(val==='CMHT'){ location.href='cmhtdaily.html'+(d?'?date='+d:''); } }
function getAllPatients(){ if(window.__fbMaster && window.__fbMaster.length) return window.__fbMaster; return []; }
function getPmjayFromTotal(shri, name){
  let shriU = (shri||'').toString().toUpperCase().trim();
  if(shriU && window.masterMapByShri[shriU] && window.masterMapByShri[shriU].pmjayId) return window.masterMapByShri[shriU].pmjayId;
  let list=getAllPatients();
  let f=list.find(p=> (p.shriId||'').toUpperCase()===shriU || (p.patientName||'').toLowerCase()=== (name||'').toLowerCase());
  return f ? (f.pmjayId||'') : '';
}
function getNameFromTotal(shri){
  let shriU = (shri||'').toString().toUpperCase().trim();
  if(shriU && window.masterMapByShri[shriU]) return window.masterMapByShri[shriU].name;
  return '';
}
let today=new Date().toISOString().slice(0,10);
try{ var urlDate=new URLSearchParams(location.search).get('date'); if(urlDate) today=urlDate; }catch(e){}
document.getElementById('d_date').value=today;
let temp={name:'',shri:'',pmjay:'',time:'',block:'',prev:''};
let currentPage=1; let firebaseList=[]; let multiList=[]; let multiEditIndex=-1; let editFbId=null;
function showSuggest(q){ let allPatients=getAllPatients(); q=q.toLowerCase().trim();let box=document.getElementById('suggest'); if(q.length<1){box.style.display='none';return;} let filtered=allPatients.filter(p=>{let n=(p.patientName||'').toLowerCase();let s=(p.shriId||'').toLowerCase();return n.includes(q)||s.includes(q);}).slice(0,20); if(!filtered.length){box.style.display='none';return;} box.innerHTML=filtered.map(p=>{return `<div onclick="pickPatient('${(p.patientName||'').replace(/'/g,"&#39;")}','${(p.shriId||'').replace(/'/g,"&#39;")}','${(p.pmjayId||'').replace(/'/g,"&#39;")}')"><b>${p.patientName}</b> - ${p.shriId} | ${p.pmjayId}</div>`;}).join('');box.style.display='block'; }
function pickPatient(name,shri,pmjay){ let finalPmjay = pmjay || getPmjayFromTotal(shri,name); document.getElementById('p_name').value=name;document.getElementById('p_shri').value=shri;document.getElementById('p_pmjay').value=finalPmjay; document.getElementById('p_search').value=name;document.getElementById('suggest').style.display='none'; temp.name=name;temp.shri=shri;temp.pmjay=finalPmjay; }
function startEntry(){ temp.name=document.getElementById('p_name').value.trim(); temp.shri=document.getElementById('p_shri').value.trim(); temp.pmjay=document.getElementById('p_pmjay').value.trim()||getPmjayFromTotal(temp.shri,temp.name); document.getElementById('p_pmjay').value=temp.pmjay; if(!temp.name){alert('Enter Name');return;} document.getElementById('timePatientLabel').textContent=temp.name+' | PMJAY: '+(temp.pmjay||'From TOTAL'); document.getElementById('popTime').style.display='flex'; }
function selectTime(t){ temp.time=t; closePop('popTime'); document.getElementById('blockPatientLabel').textContent=temp.name; document.getElementById('popBlock').style.display='flex'; }
function selectBlock(b){ temp.block=b; closePop('popBlock'); document.getElementById('showPmjayPrev').textContent=temp.pmjay||'N/A'; document.getElementById('prevPatientLabel').textContent=temp.name; document.getElementById('popPrev').style.display='flex'; }
function openMulti(){ multiList=[]; renderMultiList(); document.getElementById('m_search').value=''; document.getElementById('m_suggest').style.display='none'; document.getElementById('popMulti').style.display='flex'; }
function showMultiSuggest(q){ let allPatients=getAllPatients(); q=(q||'').toLowerCase().trim(); let box=document.getElementById('m_suggest'); if(q.length<1){box.style.display='none';return;} let filtered=allPatients.filter(p=>{let n=(p.patientName||'').toLowerCase();let s=(p.shriId||'').toLowerCase();return n.includes(q)||s.includes(q);}).slice(0,20); if(!filtered.length){box.style.display='none';return;} box.innerHTML=filtered.map(p=>{return `<div onclick="pickMulti('${(p.patientName||'').replace(/'/g,"&#39;")}','${(p.shriId||'').replace(/'/g,"&#39;")}','${(p.pmjayId||'').replace(/'/g,"&#39;")}')"><b>${p.patientName}</b> - ${p.shriId}</div>`;}).join(''); box.style.display='block'; }
function pickMulti(name,shri,pmjay){ if(multiList.some(x=>x.shri===shri && x.name===name)){ alert('Already added'); return; } let finalPmjay = pmjay || getPmjayFromTotal(shri,name); multiList.push({name:name,shri:shri,pmjay:finalPmjay,time:'',block:'',prev:''}); document.getElementById('m_search').value=''; document.getElementById('m_suggest').style.display='none'; renderMultiList(); }
function removeMulti(i){ multiList.splice(i,1); renderMultiList(); }
function renderMultiList(){ document.getElementById('m_list').innerHTML=multiList.map((p,i)=>{ return `<div class="multiRow"><div style="display:flex;justify-content:space-between"><b>${i+1}. ${p.name} - ${p.shri} | ${p.pmjay}</b><button class="delBtn" onclick="removeMulti(${i})">Remove</button></div><div style="display:flex;gap:6px;flex-wrap:wrap"><button class="btnOutline ${p.time?'filled':''}" onclick="openMultiTime(${i})">Time: ${p.time||'Select'}</button><button class="btnOutline ${p.block?'filled':''}" onclick="openMultiBlock(${i})">Block: ${p.block||'Select'}</button><button class="btnOutline ${p.prev?'filled':''}" onclick="openMultiPrev(${i})">Prev: ${p.prev||'Select'}</button></div></div>`; }).join(''); document.getElementById('m_empty').style.display=multiList.length?'none':'block'; document.getElementById('m_saveBtn').textContent='Save All ('+multiList.length+')'; }
function openMultiTime(i){ multiEditIndex=i; document.getElementById('popMTime').style.display='flex'; }
function openMultiBlock(i){ multiEditIndex=i; document.getElementById('popMBlock').style.display='flex'; }
function openMultiPrev(i){ multiEditIndex=i; document.getElementById('m_prev_date').value=multiList[i].prev||''; document.getElementById('popMPrev').style.display='flex'; }
function selectMultiTime(t){ if(multiEditIndex>=0) multiList[multiEditIndex].time=t; closePop('popMTime'); renderMultiList(); }
function selectMultiBlock(b){ if(multiEditIndex>=0) multiList[multiEditIndex].block=b; closePop('popMBlock'); renderMultiList(); }
function confirmMultiPrev(){ let v=document.getElementById('m_prev_date').value; if(!v){alert('Select date');return;} if(multiEditIndex>=0) multiList[multiEditIndex].prev=v; closePop('popMPrev'); renderMultiList(); }
async function loadFromFirebase(){
 let entryDate=document.getElementById('d_date').value||today;
 document.getElementById('dateShow').textContent=entryDate;
 try{
   let q=window.fb.query(window.fb.collection(window.db,"daily_dialysis"), window.fb.where("date","==",entryDate));
   let snap=await window.fb.getDocs(q);
   firebaseList=[];
   snap.forEach(d=>{
     let data=d.data();
     let shri = data.shriId||'';
     let pmjayFromTotal = getPmjayFromTotal(shri, data.name) || data.pmjayId || 'N/A';
     let nameFromTotal = getNameFromTotal(shri) || data.name;
     firebaseList.push({fbId:d.id, ...data, name: nameFromTotal, pmjayId: pmjayFromTotal});
   });
   document.getElementById('fbStatus').textContent=`Firebase: ${firebaseList.length} - PMJAY from TOTAL`;
   currentPage=1;renderTable();
 }catch(e){ document.getElementById('fbStatus').textContent='Error: '+e.message; }
}
async function confirmAdd(){
  let prev=document.getElementById('prev_date').value;
  if(!prev){alert('Select prev');return;}
  temp.prev=prev;
  let dialDate=document.getElementById('d_date').value||today;
  let pmjayFinal = temp.pmjay || getPmjayFromTotal(temp.shri,temp.name) || 'N/A';
  try{
    await window.fb.addDoc(window.fb.collection(window.db,"daily_dialysis"),{ date:dialDate, name:temp.name, shriId:temp.shri||'N/A', time:temp.time, pmjayId:pmjayFinal, block:temp.block, prevDate:temp.prev, createdAt:new Date().toISOString(), serverTime:window.fb.serverTimestamp() });
  }catch(e){alert(e.message);return;}
  closePop('popPrev');
  temp={name:'',shri:'',pmjay:'',time:'',block:'',prev:''};
  document.getElementById('p_name').value='';document.getElementById('p_shri').value='';document.getElementById('p_pmjay').value='';document.getElementById('p_search').value='';document.getElementById('prev_date').value='';
  await loadFromFirebase();
}
async function saveMultiple(){
  if(!multiList.length){alert('Add at least 1');return;}
  for(let p of multiList){ if(!p.time||!p.block||!p.prev){alert(p.name+' - Complete');return;} }
  let dialDate=document.getElementById('d_date').value||today;
  try{
    for(let p of multiList){
      let pmjayFinal = p.pmjay || getPmjayFromTotal(p.shri,p.name) || 'N/A';
      await window.fb.addDoc(window.fb.collection(window.db,"daily_dialysis"),{ date:dialDate, name:p.name, shriId:p.shri||'N/A', time:p.time, pmjayId:pmjayFinal, block:p.block, prevDate:p.prev, createdAt:new Date().toISOString(), serverTime:window.fb.serverTimestamp() });
    }
  }catch(e){ alert(e.message); return; }
  closePop('popMulti'); multiList=[]; await loadFromFirebase();
}
function closePop(id){document.getElementById(id).style.display='none';}
function getFilteredList(){ let timeFilter=document.getElementById('timeFilter').value; let blockFilter=document.getElementById('blockFilter').value; let searchAdded=document.getElementById('searchAdded').value.toLowerCase().trim(); let list=[...firebaseList]; if(timeFilter!=='all') list=list.filter(x=> (x.time||'').toLowerCase()===timeFilter); if(blockFilter!=='all') list=list.filter(x=> (x.block||'').toLowerCase()===blockFilter.toLowerCase()); if(searchAdded){ list=list.filter(x=>{ let n=(x.name||'').toLowerCase(); let s=(x.shriId||'').toLowerCase(); let p=(x.pmjayId||'').toLowerCase(); return n.includes(searchAdded)||s.includes(searchAdded)||p.includes(searchAdded); }); } list.sort((a,b)=>(a.name||'').toLowerCase().localeCompare((b.name||'').toLowerCase())); return list; }
function editEntry(fbId){ let rec = firebaseList.find(x=>x.fbId===fbId); if(!rec) return; editFbId = fbId; document.getElementById('editPatientLabel').textContent = rec.name; document.getElementById('edit_name').value = rec.name; document.getElementById('edit_shri').value = rec.shriId; document.getElementById('edit_pmjay').value = rec.pmjayId||''; document.getElementById('edit_time').value = rec.time||'7am'; document.getElementById('edit_block').value = rec.block||'Main'; document.getElementById('edit_prev').value = rec.prevDate||''; document.getElementById('popEdit').style.display='flex'; }
async function saveEdit(){ if(!editFbId) return; let pmjay=document.getElementById('edit_pmjay').value.trim(); let time=document.getElementById('edit_time').value; let block=document.getElementById('edit_block').value; let prev=document.getElementById('edit_prev').value; if(!prev){alert('Select Prev');return;} try{ await window.fb.updateDoc(window.fb.doc(window.db,"daily_dialysis",editFbId),{ pmjayId:pmjay||'N/A', time:time, block:block, prevDate:prev, updatedAt: new Date().toISOString() }); closePop('popEdit'); await loadFromFirebase(); }catch(e){alert(e.message);} }

// *** FIXED DELETE - ONLY 1 PATIENT ***
async function delEntry(fbId){ 
  let rec = firebaseList.find(x=>x.fbId===fbId);
  let name = rec ? rec.name + ' (SHRI: ' + rec.shriId + ')' : 'this patient';
  if(!confirm('Delete ONLY 1 patient?\n\nPatient: ' + name + '\n\nThis will delete ONLY this patient.\nIt will NOT delete all patients.'))return; 
  try{ 
    await window.fb.deleteDoc(window.fb.doc(window.db,"daily_dialysis",fbId)); 
    await loadFromFirebase(); 
  }catch(e){alert('Delete error: '+e.message);} 
}

function renderTable(){ let list=getFilteredList(); let pageSize=parseInt(document.getElementById('pageSize').value); let totalPages=Math.ceil(list.length/pageSize)||1;if(currentPage>totalPages) currentPage=totalPages; let start=(currentPage-1)*pageSize;let pageData=list.slice(start,start+pageSize); document.getElementById('tblBody').innerHTML=pageData.map((r,i)=>{ return `<tr><td>${start+i+1}</td><td style="font-weight:700">${r.name}</td><td><span class="shriPill">${r.shriId}</span></td><td style="font-weight:700">${r.time}</td><td><span class="pmjayPill">${r.pmjayId}</span></td><td style="font-weight:700">${r.block}</td><td>${r.prevDate}</td><td><div class="actionCell"><button class="editBtn" onclick="editEntry('${r.fbId}')">Edit</button><button class="delBtn" onclick="delEntry('${r.fbId}')">Delete</button></div></td></tr>`; }).join('')||`<tr><td colspan="8" style="text-align:center;color:#94a3b8;padding:20px">No patients for ${document.getElementById('d_date').value}</td></tr>`; document.getElementById('totalCount').textContent=list.length; document.getElementById('totalShow').textContent=list.length; document.getElementById('cloudCount').textContent='Firebase: '+firebaseList.length; document.getElementById('showingTxt').textContent=list.length?`${start+1}-${Math.min(start+pageSize,list.length)}`:`0`; let cont=document.getElementById('pagination');if(totalPages<=1){cont.innerHTML='';return;} let html=`<button onclick="changePage(-1)">Prev</button>`;for(let p=1;p<=totalPages;p++){html+=`<button class="${p===currentPage?'active':''}" onclick="goPage(${p})">${p}</button>`}html+=`<button onclick="changePage(1)">Next</button>`;cont.innerHTML=html; }
function goPage(p){currentPage=p;renderTable();}
function changePage(dir){currentPage=Math.max(1,currentPage+dir);let total=Math.ceil(getFilteredList().length/parseInt(document.getElementById('pageSize').value))||1;if(currentPage>total) currentPage=total;renderTable();}
function exportExcel(){ let entryDate=document.getElementById('d_date').value||today; let list=getFilteredList(); if(!list.length){ alert('No data'); return; } let exportData=list.map((r,i)=>({"Sl No":i+1,"Patient Name (TOTAL)":r.name,"SHRI ID":r.shriId,"TIME":r.time,"PMJAY ID (TOTAL)":r.pmjayId,"BLOCK":r.block,"PREV DATE":r.prevDate,"DATE":r.date})); let ws=XLSX.utils.json_to_sheet(exportData); let wb=XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb,ws,'PMJAY Daily'); XLSX.writeFile(wb,`PMJAY_DAILY_${entryDate}.xlsx`); }
document.addEventListener('click',e=>{if(!e.target.closest('.searchBox')){document.getElementById('suggest').style.display='none'; if(document.getElementById('m_suggest')) document.getElementById('m_suggest').style.display='none';}});
setTimeout(loadFromFirebase,1000);
</script>
